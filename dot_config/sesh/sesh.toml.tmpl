
[default_session]
preview_command = "eza --all --git --icons --color=always {}"


# Keep the Config workspace focused on one resumed Codex session.
[[session]]
name = "Config"
path = "~/.config"
startup_command = 'tmux rename-window codex; codex resume'


{{ if not .work -}}
# Restore the directory-specific LazyVim session when entering the katas.
[[session]]
name = "Vim Kata"
path = "~/Repos/practice-neovim/Vim-Katas/exercises/"
startup_command = "nvim -c \"lua require('persistence').load()\""

# Keep interactive Codex work separate from the frontend development server.
[[session]]
name = "Zakupki"
path = "~/Repos/zakupki"
startup_command = 'tmux rename-window codex; codex resume'
windows = ["zakupki-integration", "zakupki-gitnexus-watch"]

[[window]]
name = "zakupki-integration"
path = "~/Repos/zakupki"
startup_script = "pnpm dev:integration"

# Keep interactive Codex work separate from the backend development server.
[[session]]
name = "Zakupki Backend"
path = "~/Repos/backend_zakupki"
startup_command = 'tmux rename-window codex; codex resume'
windows = ["backend-dev", "backend-gitnexus-watch"]

[[window]]
name = "backend-dev"
path = "~/Repos/backend_zakupki"
startup_script = "./mvnw spring-boot:run -Dspring-boot.run.profiles=dev"

# Keep every Zakupki repository index current until GitNexus watch mode is released.
[[session]]
name = "Zakupki All"
path = "~/Repos/zakupki-all"
windows = ["zakupki-all-gitnexus-watch"]

[[window]]
name = "zakupki-gitnexus-watch"
path = "~/Repos/zakupki"
startup_script = "while true; do git -c core.fsmonitor=false ls-files -co --exclude-standard | entr -nd gitnexus analyze --skip-agents-md --skip-skills; done"

[[window]]
name = "zakupki-all-gitnexus-watch"
path = "~/Repos/zakupki-all"
startup_script = "while true; do git -c core.fsmonitor=false ls-files -co --exclude-standard | entr -nd gitnexus analyze --skip-agents-md --skip-skills; done"

[[window]]
name = "backend-gitnexus-watch"
path = "~/Repos/backend_zakupki"
startup_script = "while true; do git -c core.fsmonitor=false ls-files -co --exclude-standard | entr -nd gitnexus analyze --skip-agents-md --skip-skills; done"

# Resume the most relevant Codex session for the personal Obsidian workspace.
[[session]]
name = "Personal"
path = "~/Library/Mobile Documents/iCloud~md~obsidian/Documents/personal"
startup_command = "codex resume"
{{ end }}


{{ if .work -}}
[[session]]
name = "Monolith"
path = "{{ .chezmoi.homeDir }}/jira"

{{ end }}
